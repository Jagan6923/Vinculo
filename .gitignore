# Root level .gitignore for Ecommerce project

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs
logs
*.log

# IDE/Editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Build directories
build/
dist/

# Coverage reports
coverage/

# Temporary folders
tmp/
temp/

# Editor backup files
*.bak
*.tmp
*.temp

# Package manager files
package-lock.json
yarn.lock

# Documentation
docs/_build/

# Database dumps
*.sql
dump/
